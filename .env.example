# Copy this file to .env.local for local development. Never commit real values.
# See engineering/architecture.md Section 12 and engineering/security.md Section 4.

# Postgres connection string (managed Postgres in staging/production; local/Docker
# Postgres in development). Read by Prisma — see engineering/architecture.md Section 5.
DATABASE_URL=

# Transactional email API key (Resend — engineering/architecture.md Section 8/9's
# concrete recommendation for the concierge routing notification). Any comparable
# transactional email provider satisfies the same requirement; this is a procurement,
# not architectural, decision.
RESEND_API_KEY=

# Hard gate on real family data collection (engineering/architecture.md Section 6;
# product/prd.md DAT-001/BR-006). Must remain "false" in every environment until
# precondition (a)'s legal review clears and a decision to flip it is recorded in
# agent/DECISIONS.md.
INTAKE_ENABLED=false
