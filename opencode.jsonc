{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin --force*": "deny",
      "git push origin -f*": "deny",
      "*--force*": "deny",
      "git push origin *": "allow",
      "*": "ask"
    }
  }
}
