{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read(.github/workflows/**)",
      "Bash(mkdir -p *)",
      "Bash(git add --dry-run *)",
      "Bash(cd /Users/andresgi/Documents/development/venture-automata && git *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(adb devices *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__find",
      "Bash(git push origin *)"
    ],
    "deny": [
      "Bash(cd /Users/andresgi/Documents/development/venture-automata && git reset --hard*)",
      "Bash(cd /Users/andresgi/Documents/development/venture-automata && git clean*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/hooks/deny-force-push.sh",
            "statusMessage": "Checking for force-push..."
          }
        ]
      }
    ]
  }
}
