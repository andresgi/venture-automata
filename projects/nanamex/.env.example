# Environment variable names required by Clin (Nanamex). Copy to .env.local for local
# development (never commit .env.local — see .gitignore) and fill in real values from the
# relevant Supabase project's dashboard (Settings -> API / Settings -> Database).
#
# Per engineering/security.md §5 / engineering/architecture.md §13: every secret below is a
# server-side-only env var, and none of them may ever be renamed with a `NEXT_PUBLIC_*`
# prefix. `NEXT_PUBLIC_*` vars are bundled into client-side JavaScript and are, by
# definition, public — only the two Supabase values already marked NEXT_PUBLIC_ below are
# safe for that (the anon key is meaningless without RLS bypass; the URL is not secret).
#
# scripts/check-no-public-secrets.mjs enforces this file's naming convention in CI.

# --- Supabase (dev project: nanamex-dev, ref rgqncanghlvlzrzlgkzi, region sa-east-1) ---
# Safe for the browser: Supabase's anon key has no privileges beyond what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never expose to the browser, never log, never
# commit. Used by lib/supabase/server.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron endpoint protection (engineering/architecture.md §20, security.md §5) ---
# Shared-secret header checked by /api/cron/* — set once E0-xx wires the retention cron.
CRON_SECRET=

# --- Application / Stripe ---
# Absolute HTTPS origin used for Stripe return URLs. Never derive this from request headers.
# Local fallback is http://localhost:3000 only when APP_URL is unset in development/test.
APP_URL=https://clin.example
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SIGNING_SECRET=

# --- Twilio Verify (wired in E0-05) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- PostHog (product analytics) ---
# Safe for the browser: PostHog's client-side capture key is designed to be public.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (error monitoring) ---
SENTRY_DSN=
